/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-ai-command-center",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// API and WebSocket routes always go to the Worker (owner check runs there)
		"run_worker_first": ["/api/*", "/ws"]
	},
	"observability": {
		"enabled": true
	},
	/**
	 * Workers AI - the brain of your AI workers
	 * https://developers.cloudflare.com/workers-ai/
	 */
	"ai": {
		"binding": "AI"
	},
	"vars": {
		// Any Workers AI text-generation model
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
	},
	/**
	 * Secrets (never commit these):
	 *   OWNER_TOKEN - your private password for the Command Center (16+ chars)
	 *   Set with: npx wrangler secret put OWNER_TOKEN
	 *   Local dev: put OWNER_TOKEN=... in .dev.vars
	 */
	"secrets": {
		"required": ["OWNER_TOKEN"]
	},
	/**
	 * Workflows - one durable run per task
	 * https://developers.cloudflare.com/workflows/
	 */
	"workflows": [
		{
			"name": "agent-task",
			"binding": "AGENT_TASK",
			"class_name": "AgentTaskWorkflow"
		}
	],
	/**
	 * Durable Objects - stores your rules, workers, tasks and audit log
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "COMMAND_CENTER",
				"class_name": "CommandCenterDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CommandCenterDO"]
		}
	],
	"upload_source_maps": true
}
